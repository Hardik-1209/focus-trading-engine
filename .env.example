# Focus Trading Engine — Environment Variables Template
# Copy this file to .env and fill in your credentials

# ─── Supabase Database ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Exchange Credentials (Bitget USDT-M Futures) ───────────────────────────
BITGET_API_KEY=your-bitget-api-key
BITGET_SECRET_KEY=your-bitget-secret-key
BITGET_PASSPHRASE=your-bitget-passphrase

# ─── LLM Configuration ──────────────────────────────────────────────────────
# Cloud LLM: Groq API with smart key rotation across 5 keys
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your-groq-key-1
GROQ_API_KEY2=your-groq-key-2
GROQ_API_KEY3=your-groq-key-3
GROQ_API_KEY4=your-groq-key-4
GROQ_API_KEY5=your-groq-key-5

# ─── Focus Engine Settings ───────────────────────────────────────────────────
WATCH_DURATION_MINUTES=30
DRY_RUN=true
MAX_CONCURRENT_PIPELINES=2
MIN_VOLUME_USDT=500000
PORT=3000

# ─── Cloud & Deployment ──────────────────────────────────────────────────────
supabase_accesss_token=your-supabase-access-token
render_api_key=your-render-api-key
github_pat_token=your-github-pat-token
